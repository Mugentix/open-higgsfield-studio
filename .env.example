# KIE.ai API key (https://kie.ai/api-key). The deployment's fallback for every
# team that has not set its own key in the studio.
KIE_API_KEY=
# Override only if KIE moves hosts. Uploads answer on their own host.
KIE_API_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# Set to 1 to see catalog entries still gated behind a live probe.
NEXT_PUBLIC_KIE_EXPERIMENTAL_MODELS=

# Postgres. Leave empty on a local checkout to use the embedded database under
# .data/pglite. Production: a Neon (or any Postgres) connection string.
DATABASE_URL=
# Set to 1 to run migrations on startup instead of `pnpm db:migrate`.
DB_AUTO_MIGRATE=

# Sessions. `openssl rand -base64 32`. Required in production.
BETTER_AUTH_SECRET=
# The public origin the app runs on (sign-in links point here).
BETTER_AUTH_URL=http://localhost:3000
# Seals the team's KIE key at rest. Any long random string. Required in production.
APP_SECRET_KEY=

# Sign-in links and invitations. Without Resend a local checkout prints links
# to the server log and /api/dev/mail.
RESEND_API_KEY=
EMAIL_FROM="Studio <studio@yourdomain.com>"
# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Media. Cloudflare R2 through the S3 API; leave empty on a local checkout to
# keep objects under .data/media, served by the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# The public https origin. When set, KIE is given a callback url per run.
APP_PUBLIC_URL=
# Webhook HMAC key from https://kie.ai/settings. Callbacks are verified with it.
KIE_WEBHOOK_HMAC_KEY=
# Bearer token the minute cron sends to /api/cron/tick. Required in production.
CRON_SECRET=

# 1 shows the Agents page and sidebar entry and accepts skill uploads. Off by default.
NEXT_PUBLIC_AGENTS=

# Agent worker (`pnpm agent-worker`, docs/agent-worker.md). Runs on a box with
# Python, ffmpeg and Whisper; shares DATABASE_URL and the media vars above.
# The Anthropic key the Claude Agent SDK bills; required for the "claude" runtime.
ANTHROPIC_API_KEY=
# Where each team's HOME lives on the worker; empty = .data/agent-homes/<teamId>.
AGENT_HOME_ROOT=
# "fake" replays a scripted run with no model and no key (tests, UI work).
AGENT_RUNTIME=
# 1 makes `pnpm dev` host the worker's loop itself (the embedded database admits
# one process); ignored in production. With AGENT_RUNTIME=fake the Agents page
# plays a scripted run with no model.
AGENT_DEV_WORKER=
# Runs one worker holds at once (default 2).
AGENT_WORKER_CONCURRENCY=
# Model for the agent loop; empty = Claude Code's default. AGENT_FALLBACK_MODEL optional.
AGENT_MODEL=
# Path to a Claude Code binary when the SDK's bundled one is not installed.
AGENT_CLAUDE_PATH=
# Keys the owner's skills read beside the team's KIE key; passed to the scripts when set.
HF_KEY=
ELEVENLABS_API_KEY=
